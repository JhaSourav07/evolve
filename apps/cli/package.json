{
  "name": "@evolve/cli",
  "version": "0.1.0",
  "description": "Interactive terminal user interface for the Evolve autonomous AI coding agent",
  "type": "module",
  "bin": {
    "evolve": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@evolve/agent": "workspace:*",
    "@evolve/core": "workspace:*",
    "@evolve/db": "workspace:*",
    "@evolve/indexer": "workspace:*",
    "@evolve/integrations": "workspace:*",
    "commander": "^15.1.0",
    "ink": "^8.0.0",
    "react": "^19.3.1"
  },
  "keywords": [
    "ai",
    "agent",
    "cli"
  ],
  "author": "Sourav Jha",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.3.0"
  }
