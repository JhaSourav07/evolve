{
  "name": "@evolve/planner",
  "version": "0.4.1",
  "description": "Repository-aware planning engine, DAG task decomposition, and risk assessment for Evolve",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@evolve/core": "workspace:*",
    "@evolve/db": "workspace:*",
    "@evolve/indexer": "workspace:*",
    "better-sqlite3": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0"
  },
  "keywords": [
    "ai",
    "agent",
    "planner",
    "dag",
    "task-decomposition",
    "risk-assessment"
  ],
  "author": "Sourav Jha",
  "license": "MIT"
}
