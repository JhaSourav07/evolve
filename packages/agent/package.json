{
  "name": "@evolve/agent",
  "version": "0.4.0",
  "description": "Agent runtime, Ollama model provider, and execution loop for Evolve",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
