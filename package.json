{
  "name": "evolve-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, self-improving AI coding agent built from scratch",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && git clean -xdf -e node_modules",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "keywords": [
    "ai",
    "agent",
    "local-first",
    "self-improving",
    "typescript"
  ],
  "author": "Sourav Jha",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
